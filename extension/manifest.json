{
  "manifest_version": 3,
  "name": "FLOW CONNECT Bridge",
  "version": "1.0.0",
  "description": "Menghubungkan FLOW CONNECT dengan tab Google Flow milikmu: kirim gambar & prompt ke Flow, lihat dan unduh hasil Flow dari FLOW CONNECT.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://flow-content.google/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://flow-connect-2qu.pages.dev/*",
      "https://*.flow-connect-2qu.pages.dev/*",
      "http://localhost:5173/*"
    ]
  },
  "action": {
    "default_title": "FLOW CONNECT Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}

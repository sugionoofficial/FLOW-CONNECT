{
  "name": "flow-connect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-extension.mjs && vite",
    "build": "node scripts/build-extension.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf:preview": "npm run build && wrangler dev --ip 0.0.0.0 --port 8787",
    "build:extension": "node scripts/build-extension.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.168.0"
  }
}
